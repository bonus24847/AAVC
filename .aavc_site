# Per-repo SITE marker — this is aavc-comp (KMITL COMPETITION field).
# Sourced by sitl/run_mission.sh. It sets the field defaults ONLY if an icon's
# env did not already ("${VAR:-default}"), so an explicit icon env still wins.
#
# ⚠ sync_core.sh deliberately does NOT copy this file — it is the ONE thing that
# distinguishes aavc-comp from aavc-practice (which ships kmutnb_skyfield +
# sitl/aavc_config.yaml). Flight-core fixes arrive via sync_core.sh from
# aavc-practice; this repo owns only its field identity + the KMITL config.
AAVC_PROFILE="${AAVC_PROFILE:-competition}"
AAVC_CONFIG="${AAVC_CONFIG:-sitl/kmitl_config.yaml}"
