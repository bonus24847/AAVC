<?xml version='1.0' encoding='UTF-8'?>
<!--
  EFT X6100 hexacopter, flyable AAVC config = frame + 6 motors + nadir camera.
  Spawned by the PX4 posix airframe 22000_gz_eft_x6100 (PX4_SIM_MODEL=eft_x6100).

  Motor plugin motorNumber N consumes Actuators.velocity[N], which PX4 fills from
  output channel N = Motor N+1 via SIM_GZ_EC_FUNC(N+1)=101+N. The rotor link
  positions and spin directions are in eft_x6100_base/model.sdf and mirror the
  real 6X's CA_ROTOR* table (airframe 6001) — read that header before touching
  either file, and change both together.

  Rotor aero is fitted to the MANUFACTURER BENCH TABLE for the EFT E5
  (5008/335KV on an 18x6.5" prop, 24 V) reproduced in Power-System-Guide-1.pdf:
  3,838 g at 100 % throttle => F_max = 37.65 N per motor, so
  motorConstant = 37.65 / 1000^2 = 3.765e-5 N/(rad/s)^2.
  Sanity: 8.22 kg AUW (two 6S 7500 mAh packs in parallel, 2026-07-25) needs
  13.44 N per motor => 597 rad/s, and total thrust 226 N gives T/W 2.80
  against the document's 23 kg / 8.22 kg = 2.80.

  THROTTLE AXIS: the airframe pins SIM_GZ_EC_MIN = 150, so PX4's throttle maps to
  omega as w = 150 + 850*t, NOT through the origin. The hover point above
  therefore sits at throttle 0.53 (which is what MPC_THR_HOVER is set to), not at
  the 0.597 a through-origin map would give — a 13 % difference, so re-derive
  against 150+850t or the number will be wrong. Forcing EC_MIN to 0 to make the
  sim and bench throttle axes agree was tried and REVERTED: with no idle floor
  the motors sit at zero after arming and the aircraft never spools up. See the
  airframe file's own header, which owns this decision.

  NADIR camera: same contract as the retired x500_mono_cam — link pitched +pi/2
  so the optical axis looks straight DOWN, gz topic `camera`, 1280x720 @ 15 Hz.
  At the KMUTNB 4 m sweep the 400 mm marker is ~54 px — decodes trivially
  (the old 12 m/18 px booster regime is gone). It is the SOLE control-authority
  sensor.
  Mount height (KMUTNB spec 2026-08-11): the REAL aircraft carries the camera
  and the rangefinder 0.25 m below the CG.
  ⚠ FRAME RULE (bug found by the sibling session 2026-08-14): the merge-
  include of eft_x6100_base CARRIES its root <pose> 0 0 0.35 — gz creates a
  _merged__..._model__ frame at +0.35 and base_link rides on it (verified
  with `gz sdf -p`). Every TOP-LEVEL pose in THIS file is therefore in the
  MODEL frame = base-frame z + 0.35: camera_link z 0.10 == base −0.25
  (matching lidar_sensor_link, which is INSIDE base and needs no offset).
  Authored as −0.25 the lens really sat 0.60 below CG — parked 7 cm under
  ground, and ~9 % AGL error in every pad fix at the 4 m sweep. A landed
  base_link sits ~0.298 m up → lens parks ~0.048 m AGL, above the 0.02 m
  near-clip; in flight the view is clear (payload rack bottoms are level
  with the lens plane, nothing extends below it).
-->
<sdf version='1.9'>
  <model name='eft_x6100'>
    <include merge='true'>
      <uri>eft_x6100_base</uri>
    </include>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp>
      <timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>3.765e-05</motorConstant>
      <momentConstant>0.02</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>1.75e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp>
      <timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>3.765e-05</motorConstant>
      <momentConstant>0.02</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>1.75e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp>
      <timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>3.765e-05</motorConstant>
      <momentConstant>0.02</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>1.75e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp>
      <timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>3.765e-05</motorConstant>
      <momentConstant>0.02</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>1.75e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_4_joint</jointName>
      <linkName>rotor_4</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp>
      <timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>3.765e-05</motorConstant>
      <momentConstant>0.02</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>4</motorNumber>
      <rotorDragCoefficient>1.75e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_5_joint</jointName>
      <linkName>rotor_5</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp>
      <timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>3.765e-05</motorConstant>
      <momentConstant>0.02</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>5</motorNumber>
      <rotorDragCoefficient>1.75e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <link name="camera_link">
      <!-- MODEL-frame z = base-frame −0.25 PLUS the merged base's +0.35 root
           pose (frame bug found by the sibling session 2026-08-14: authored
           as −0.25 this lens actually sat 0.60 below the CG — parked it was
           7 cm underground, and every pad fix carried a ~9 % AGL error). -->
      <pose>0 0 0.10 0 1.5708 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.050</mass>
        <inertia>
          <ixx>0.00004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00004</iyy>
          <iyz>0</iyz>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <sensor name="imager" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.295</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.02</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>camera</topic>
      </sensor>
      <gravity>true</gravity>
      <velocity_decay/>
    </link>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- Cargo payloads (Task 10; NESTED since 2026-08-12): base_link <->
         cargo_payload_N, one DetachableJoint per box, N in 0..3. The boxes
         are nested includes of THIS model (below), so they spawn atomically
         with the aircraft and every joint binds before the first physics
         step — no more pre-placing them in the world and hoping the spawn
         race holds (the old aavc_field.sdf approach).

         MOUNT HEIGHT (user spec 2026-08-12; FRAME-FIXED 2026-08-14): the
         latch point is the servo rack at (±0.10, ±0.035, base z 0) — ON the
         CG plane — so each box hangs with its TOP FACE at base z 0: centre
         at base −0.09 (0.18 tall, spans base −0.18..0), which in the MODEL
         frame (base +0.35 via the merged root pose — see header) is
         z = 0.26. Authored as −0.09 the boxes really hung 0.44 below CG —
         bottoms 26 cm BELOW the skid plane, so the aircraft landed ON the
         cargo stack and every release dropped it ~23 cm onto the gear (the
         "lurch" the operators saw). The box overlaps
         base_link_collision_body (base −0.02..+0.06) by 2 cm, which is why
         cargo_payload masks its collision to 0x02 and the airframe masks
         0xfd — box<->airframe never contact, box<->ground/slab/pad still
         do. Box bottoms at base −0.18 stay ABOVE the sensor plane (camera +
         lidar lenses at base −0.25), so the nadir cone and the lidar ray
         remain unobstructed; parked they sit ~0.118 m AGL, clear of the
         ground.

         Tier 1 (in flight, no extra code): each ~90 g box rides as dead
         weight through its joint constraint and loads the flight dynamics
         for as long as it stays attached — gz's physics solver carries it,
         nothing here has to inject mass separately.

         Tier 2 (release): publishing an Empty message on a plugin's
         <detach_topic> breaks THAT joint only, so the box falls free onto
         the pad — sitl/payload_detach_bridge.py (Task 11) fires this from
         the flight core's own DELIVERY k RELEASE payload=N audit line (or
         the gz servo topics in servo mode), so the SITL drop needs no
         change to the flight core. -->
    <!-- CORNER ASSIGNMENT (re-permuted 2026-08-15 to the as-wired rack):
         cargo_payload_N is the box on the latch driven by ACTUATOR SET N+1,
         i.e. AUX pin N+1 (SIM_GZ_SV_FUNC(N+1) -> servo_N -> this box) — so
         each box sits at the corner that AUX pin physically serves on the
         real bird: AUX1 rear-right, AUX2 front-right, AUX3 rear-left, AUX4
         front-left (docs/SERVO_AUX_MAPPING.md). Box index is therefore NOT
         payload_id: the mission's delivery order 0..3 maps through
         connection.drop_servo_channels = [4, 1, 2, 3], so payload 0 sheds
         box 3 (front-left) — which is what payload_detach_bridge reproduces
         on the audit path from its own channel-map flag. The four poses are
         the same four corners as before the permutation, so mass and inertia
         are unchanged. -->
    <include>
      <name>cargo_payload_0</name>
      <uri>model://cargo_payload</uri>
      <pose>-0.10 -0.035 0.26 0 0 0</pose>
    </include>
    <include>
      <name>cargo_payload_1</name>
      <uri>model://cargo_payload</uri>
      <pose>0.10 -0.035 0.26 0 0 0</pose>
    </include>
    <include>
      <name>cargo_payload_2</name>
      <uri>model://cargo_payload</uri>
      <pose>-0.10 0.035 0.26 0 0 0</pose>
    </include>
    <include>
      <name>cargo_payload_3</name>
      <uri>model://cargo_payload</uri>
      <pose>0.10 0.035 0.26 0 0 0</pose>
    </include>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      <child_model>cargo_payload_0</child_model>
      <child_link>payload</child_link>
      <detach_topic>/model/eft_x6100/detach_payload_0</detach_topic>
    </plugin>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      <child_model>cargo_payload_1</child_model>
      <child_link>payload</child_link>
      <detach_topic>/model/eft_x6100/detach_payload_1</detach_topic>
    </plugin>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      <child_model>cargo_payload_2</child_model>
      <child_link>payload</child_link>
      <detach_topic>/model/eft_x6100/detach_payload_2</detach_topic>
    </plugin>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      <child_model>cargo_payload_3</child_model>
      <child_link>payload</child_link>
      <detach_topic>/model/eft_x6100/detach_payload_3</detach_topic>
    </plugin>
  </model>
</sdf>
