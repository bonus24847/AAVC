<?xml version="1.0" ?>
<!--
  AAVC practice world — the KMUTNB rooftop football pitch (สนามฟุตบอลลอยฟ้า
  มจพ. บางซื่อ), Gazebo Harmonic.

  MISSION (same profile as the KMITL aavc_field world): an autonomous PX4
  hexacopter delivers ONE egg cargo per sortie to the landing pad matching the
  assigned ArUco id (DICT_4X4_50, ids 1-6): mandatory transit P1->P2->P3,
  boustrophedon search, land ON the pad, release after touchdown, egress, land
  at L&R, resupply, repeat. 6 physical pads, 4 assigned => 2 distractors.
  KMUTNB deltas: 5 m altitude ceiling (4 m transit / sweep), accuracy over
  speed, and the operating area is the user-briefed 60 x 44 m rotated
  rectangle centred on the pitch (field only — NOT the running track).

  Coordinate origin (spherical_coordinates) is the LAUNCH & RECOVERY point:
  13.8224940 N, 100.5122771 E — on the pitch long axis, field-frame s=+24 m
  (toward the SE goal) from the centre circle. elevation 15 = the rooftop
  pitch surface; world z=0 IS that surface. Local ENU: +X east, +Y north.
  ALL numbers below come from tools/gen_geo.py — the geometry invariant
  (config site.center == this block == PX4_HOME_* == spawn_targets origin ==
  fetch_sat LAT0/LON0) is generated, never hand-derived. The pitch long axis
  bears 143.8 deg true, so every mission rectangle here is ROTATED in ENU
  (see aavc_config.yaml search.sweep_axis_deg).

  FIELD LAYOUT (local ENU, metres, from gen_geo):
    - controlled airspace quad: (-49.6,+30.6) (-14.2,-17.8) (+21.3,+8.2)
      (-14.1,+56.6)  [60 x 44 m, pitch only]
    - search area quad: (-46.9,+30.1) (-29.1,+5.9) (+3.1,+29.6) (-14.6,+53.8)
    - transit: P1 (-8.4,+1.3) -> P2 (-17.5,+7.0) -> P3 (-13.0,+17.8)
    - pitch centre circle at ENU (-14.17,+19.37).
    - baseline pads (id@ENU): 1@(-30.6,17.3) 3@(-18.9,25.8) 4@(-7.2,34.4)
      6@(-39.8,29.8) 2@(-28.1,38.3) 5@(-16.4,46.9) — >=14.5 m pairwise,
      >=4.5 m inside the search polygon; mirrored in spawn_targets.py
      BASELINE_PADS (tests/test_spawn_targets.py locks the mirror).
-->
<sdf version="1.9">
  <world name="kmutnb_skyfield">

    <!-- World origin = L&R point (== config site.center == PX4_HOME_*). -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>13.8224940</latitude_deg>
      <longitude_deg>100.5122771</longitude_deg>
      <elevation>15</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Physics step. PX4 v1.15+ SITL expects 1 kHz update rate. Without
         an explicit <physics> block gz-sim 8 (Harmonic) falls back to its
         own default which can desynchronise the gz_bridge handshake and
         trigger "Service call timed out" on model spawn. -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Standard physics + sensors plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- Wind plugin — a rooftop pitch is exposed, keep the breeze for
         landing-precision realism. Tuning: sitl/aavc_config.yaml.wind_sitl. -->
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <horizontal>
        <magnitude>
          <time_for_rise>10</time_for_rise>
          <sin>
            <amplitude_percent>0.5</amplitude_percent>
            <period>60</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.5</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>20</time_for_rise>
          <sin>
            <amplitude>15</amplitude>
            <period>120</period>
          </sin>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.1</stddev>
        </noise>
      </vertical>
    </plugin>
    <wind>
      <linear_velocity>3 0 0</linear_velocity>
    </wind>

    <!-- Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 200 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- Ambient + sky -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.85 1.0</background>
      <sky/>
    </scene>

    <!-- Collision ground plane, slightly larger than the 250 x 220 m
         satellite visual so nothing can fall off the edge. Centred on the
         pitch centre circle ENU (-14.17, +19.37). The visual is a dull
         asphalt grey (V~90, far under the pad detector's white-cue
         threshold) that only shows in the border strip outside ground_sat. -->
    <model name="ground_plane">
      <static>true</static>
      <pose>-14.17 19.37 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 260</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 260</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.32 0.33 0.34 1</ambient>
            <diffuse>0.36 0.37 0.38 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Real Google z20 satellite imagery of the sky-field + surroundings
         (sitl/models/ground_sat, fetched by tools/fetch_sat.py). Visual-only,
         2 mm above the collision plane; the pads' top faces are at z 0.01 so
         there is no z-fight. Same pose/centre as the collision plane. -->
    <include>
      <name>ground_sat</name>
      <uri>model://ground_sat</uri>
      <pose>-14.17 19.37 0.002 0 0 0</pose>
    </include>

    <!-- Resupply set-dressing: 4 static cargo-box dummies staged on the east
         side of the 6x6 m L&R slab, clear of the (0,0) spawn, the H marker
         (|x| <= 2.0) and the corner posts (±2.8, ±2.8). z=0.10 = slab top. -->
    <include>
      <name>cargo_box_1</name>
      <uri>model://cargo_box</uri>
      <pose>2.3 1.0 0.10 0 0 0.3</pose>
    </include>
    <include>
      <name>cargo_box_2</name>
      <uri>model://cargo_box</uri>
      <pose>2.3 -1.0 0.10 0 0 -0.5</pose>
    </include>
    <include>
      <name>cargo_box_3</name>
      <uri>model://cargo_box</uri>
      <pose>2.7 0.4 0.10 0 0 1.1</pose>
    </include>
    <include>
      <name>cargo_box_4</name>
      <uri>model://cargo_box</uri>
      <pose>2.7 -0.4 0.10 0 0 -1.2</pose>
    </include>

    <!-- ============================================================
         DYNAMIC BELLY CARGO: 4 cargo_payload boxes (~90 g each, real mass +
         inertia) pre-placed at the WORLD-ORIGIN spawn belly so their
         DetachableJoints (sitl/models/eft_x6100/model.sdf, base_link <->
         cargo_payload_N) bind the instant PX4 spawns the aircraft there.
         Coupled to launch_sitl.sh PX4_GZ_MODEL_POSE="0,0,0.35,0,0,0".

         KMUTNB 4-SERVO RACK (user spec 2026-08-11): the release servos sit at
         (±0.10, ±0.035, 0) on the airframe — a tight rectangle around the CG
         at the CG plane — mapped to DO_SET_ACTUATOR servo 1..4. Each payload
         hangs under its servo, so the boxes spawn at the SAME x/y with yaw 0
         (box footprint 0.16 x 0.065 m: y edges gap 5 mm — cargo_payload.sdf
         was slimmed 0.07 -> 0.065 for exactly this rack; x edges gap 40 mm).

         z derivation (same I6 logic as the KMITL world): gz runs `-r` before
         PX4 spawns, so each box must REST on the slab, not float or
         penetrate: z = slab top 0.10 + box half-height 0.09 = 0.19 (box spans
         world z 0.10..0.28). Clearances at spawn (base_link z 0.35):
           - base_link_collision_body world z [0.33, 0.41]: box top 0.28 stays
             0.05 m below it (the x/y footprints DO overlap now — the rack is
             under the belly — so the z gap is the load-bearing clearance).
           - belly sensors: camera + lidar lenses at z -0.25 => world 0.10 at
             spawn... while LANDED. In flight the boxes hang z -0.25..-0.07
             below base_link, bottoms level WITH the sensor plane, so the
             nadir cone and the lidar ray stay unobstructed (nothing extends
             below the lens plane).
           - skid rails y ±[0.305, 0.335]: boxes |y| <= 0.0675 — never in the
             same Y band.
         Sign alternation 0:+x+y 1:-x-y 2:+x-y 3:-x+y keeps the net CG moment
         zero when full and again after the first two releases; the worst
         intermediate offset is one box: 0.09 kg x 0.106 m / 8.2 kg = 1.2 mm
         of CG travel. Shed by sitl/payload_detach_bridge.py (audit mode) or
         by the servo mode watching /model/eft_x6100/servo_0..3. -->
    <include>
      <name>cargo_payload_0</name>
      <uri>model://cargo_payload</uri>
      <pose>0.10 0.035 0.19 0 0 0</pose>
    </include>
    <include>
      <name>cargo_payload_1</name>
      <uri>model://cargo_payload</uri>
      <pose>-0.10 -0.035 0.19 0 0 0</pose>
    </include>
    <include>
      <name>cargo_payload_2</name>
      <uri>model://cargo_payload</uri>
      <pose>0.10 -0.035 0.19 0 0 0</pose>
    </include>
    <include>
      <name>cargo_payload_3</name>
      <uri>model://cargo_payload</uri>
      <pose>-0.10 0.035 0.19 0 0 0</pose>
    </include>

    <!-- Launch / recovery slab (6 x 6 m — scaled to the small field; the
         L&R zone radius in config is 8 m). Grey (V~128) stays under the pad
         detector's white-cue threshold (V>=170). Top face at world z=0.10. -->
    <model name="launch_pad">
      <static>true</static>
      <pose>0 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>6 6 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.62 0.62 0.62 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>6 6 0.1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================
         6 ARUCO LANDING PADS (1x1 m white pad, black ring, central 0.4 m
         DICT_4X4_50 marker; sitl/models/landing_pad_id_*, baked by
         tools/gen_pads.py). ENU poses from gen_geo — inside the rotated
         search quad, >=14.5 m separation, each at a different yaw so decode
         must be rotation-invariant. These EXACT poses/ids are the no-seed
         defaults in spawn_targets.py BASELINE_PADS. `make spawn-targets
         SEED=n` re-places them at runtime. ids 2 and 5 (pad_5, pad_6) are
         the permanent distractors whenever they are not assigned.
         ============================================================ -->
    <include>
      <name>pad_1</name>
      <uri>model://landing_pad_id_1</uri>
      <pose>-30.6 17.3 0 0 0 0.0</pose>
    </include>
    <include>
      <name>pad_2</name>
      <uri>model://landing_pad_id_3</uri>
      <pose>-18.9 25.8 0 0 0 0.95993</pose>
    </include>
    <include>
      <name>pad_3</name>
      <uri>model://landing_pad_id_4</uri>
      <pose>-7.2 34.4 0 0 0 2.09440</pose>
    </include>
    <include>
      <name>pad_4</name>
      <uri>model://landing_pad_id_6</uri>
      <pose>-39.8 29.8 0 0 0 4.18879</pose>
    </include>
    <include>
      <name>pad_5</name>
      <uri>model://landing_pad_id_2</uri>
      <pose>-28.1 38.3 0 0 0 2.96706</pose>
    </include>
    <include>
      <name>pad_6</name>
      <uri>model://landing_pad_id_5</uri>
      <pose>-16.4 46.9 0 0 0 5.23599</pose>
    </include>

    <!-- ============================================================
         TAKEOFF MARKER at the L&R slab (world origin = drone spawn).
         White helipad "H" + a magenta beacon pole (north of the slab, clear
         of the 0,0,0 spawn) + four orange corner posts at the slab corners.
         All visuals are collision-free.
         ============================================================ -->
    <model name="takeoff_marker">
      <static>true</static>
      <link name="link">
        <visual name="h_bar_left">
          <pose>0 -1.6 0.13 0 0 0</pose>
          <geometry><box><size>4.0 0.5 0.06</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="h_bar_right">
          <pose>0 1.6 0.13 0 0 0</pose>
          <geometry><box><size>4.0 0.5 0.06</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="h_cross">
          <pose>0 0 0.13 0 0 0</pose>
          <geometry><box><size>0.6 3.2 0.06</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="beacon_pole">
          <pose>0 4.0 3.0 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>6.0</length></cylinder></geometry>
          <material><ambient>0.7 0.0 0.6 1</ambient><diffuse>0.95 0.1 0.85 1</diffuse></material>
        </visual>
        <visual name="beacon_ball">
          <pose>0 4.0 6.2 0 0 0</pose>
          <geometry><sphere><radius>0.45</radius></sphere></geometry>
          <material>
            <ambient>0.9 0.8 0.0 1</ambient>
            <diffuse>1.0 0.9 0.1 1</diffuse>
            <emissive>0.6 0.5 0.0 1</emissive>
          </material>
        </visual>
        <visual name="post_ne"><pose>2.8 2.8 0.6 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>1.2</length></cylinder></geometry><material><ambient>0.85 0.4 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual>
        <visual name="post_nw"><pose>-2.8 2.8 0.6 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>1.2</length></cylinder></geometry><material><ambient>0.85 0.4 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual>
        <visual name="post_se"><pose>2.8 -2.8 0.6 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>1.2</length></cylinder></geometry><material><ambient>0.85 0.4 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual>
        <visual name="post_sw"><pose>-2.8 -2.8 0.6 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>1.2</length></cylinder></geometry><material><ambient>0.85 0.4 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================================================
         SPECTATOR CAMERA: fixed third-person ground camera 18 m south of the
         slab, 2.5 m up, looking NORTH, pitched up ~15 deg. ENU (0,-18) is
         outside the 60x44 m airspace (field-frame s=38.5), still on the
         rooftop. Publishes /spectator_camera -> gz_camera_bridge ->
         /tmp/aavc_spectator.png -> dashboard.
         ============================================================ -->
    <include>
      <name>spectator_cam</name>
      <uri>model://spectator_cam</uri>
      <pose>0 -18 2.5 0 -0.26 1.5708</pose>
    </include>

    <!-- No decorative trees/houses/cars: this is a rooftop pitch — the
         surroundings come from the ground_sat satellite imagery instead. -->

  </world>
</sdf>
