<?xml version="1.0" encoding="UTF-8"?>
<!--
  AAVC 2026 cargo dummy — the rules-V1.3 organiser package (Fig. 5): a
  heart-shaped 300-gsm art-card box, ~16 x 7 x 18 cm (W x D x H), one raw
  no.0 egg inside, with a handle loop. Modelled as a white card box with the
  navy/orange print band and a small handle — VISUAL SET-DRESSING at the L&R
  pad only (the resupply scene). Detector-safe by geometry: the 16 x 7 cm top
  face is ~4 px from 20 m (far below the 18 px blob floor) and its 16:7 aspect
  fails the square-aspect gate, so it can never false-cue as a landing pad.

  Origin at the box base: include with pose z = supporting-surface top (the
  launch pad top sits at z = 0.10).
-->
<sdf version="1.9">
  <model name="cargo_box">
    <static>true</static>
    <link name="link">
      <!-- white card body (16 x 7 x 18 cm), base at z=0 -->
      <visual name="body">
        <pose>0 0 0.09 0 0 0</pose>
        <geometry>
          <box><size>0.16 0.07 0.18</size></box>
        </geometry>
        <material>
          <ambient>0.92 0.92 0.90 1</ambient>
          <diffuse>0.96 0.96 0.94 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <!-- navy print band (the heart-box artwork) -->
      <visual name="print_band">
        <pose>0 0 0.055 0 0 0</pose>
        <geometry>
          <box><size>0.162 0.072 0.05</size></box>
        </geometry>
        <material>
          <ambient>0.10 0.14 0.30 1</ambient>
          <diffuse>0.13 0.18 0.38 1</diffuse>
        </material>
      </visual>
      <!-- orange accent stripe -->
      <visual name="accent_stripe">
        <pose>0 0 0.095 0 0 0</pose>
        <geometry>
          <box><size>0.162 0.072 0.02</size></box>
        </geometry>
        <material>
          <ambient>0.85 0.40 0.05 1</ambient>
          <diffuse>1.00 0.50 0.08 1</diffuse>
        </material>
      </visual>
      <!-- handle loop over the top -->
      <visual name="handle">
        <pose>0 0 0.20 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.022</radius><length>0.012</length></cylinder>
        </geometry>
        <material>
          <ambient>0.10 0.14 0.30 1</ambient>
          <diffuse>0.13 0.18 0.38 1</diffuse>
        </material>
      </visual>
      <!-- single collision = the card box itself -->
      <collision name="collision">
        <pose>0 0 0.09 0 0 0</pose>
        <geometry>
          <box><size>0.16 0.07 0.18</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
