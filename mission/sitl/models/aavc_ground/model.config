<?xml version="1.0"?>
<model>
  <name>aavc_ground</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>AAVC 2026 team</name>
    <email>pakin.c@eng.kmutnb.ac.th</email>
  </author>
  <description>
    Texture-resource model for the AAVC field ground. Holds the procedural
    grass/earth albedo (materials/textures/grass.png) referenced by the
    ground_plane in sitl/worlds/aavc_field.sdf via model://aavc_ground/...
    Not spawned on its own — it exists so the model:// texture URI resolves.
  </description>
</model>
