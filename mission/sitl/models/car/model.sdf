<?xml version="1.0" ?>
<!-- Primitive car: blue chassis + cabin + 4 black wheels (~4 m long). Static
     scenery near the launch zone / field edge. Wheels are cylinders rolled
     90 deg about X so their axis runs along the car's lateral (Y) axis. -->
<sdf version="1.9">
  <model name="car">
    <static>true</static>
    <link name="link">
      <visual name="chassis">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry>
          <box><size>4.0 1.8 0.6</size></box>
        </geometry>
        <material>
          <ambient>0.13 0.22 0.55 1</ambient>
          <diffuse>0.18 0.32 0.80 1</diffuse>
        </material>
      </visual>
      <visual name="cabin">
        <pose>-0.2 0 1.05 0 0 0</pose>
        <geometry>
          <box><size>2.0 1.6 0.6</size></box>
        </geometry>
        <material>
          <ambient>0.13 0.22 0.55 1</ambient>
          <diffuse>0.18 0.32 0.80 1</diffuse>
        </material>
      </visual>
      <visual name="wheel_fl">
        <pose>1.3 0.9 0.35 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="wheel_fr">
        <pose>1.3 -0.9 0.35 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="wheel_rl">
        <pose>-1.3 0.9 0.35 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="wheel_rr">
        <pose>-1.3 -0.9 0.35 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <collision name="col">
        <pose>0 0 0.6 0 0 0</pose>
        <geometry><box><size>4.0 1.8 1.2</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
