<?xml version="1.0"?>
<model>
  <name>cargo_payload</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>AAVC</name></author>
  <description>AAVC 2026 DYNAMIC cargo payload (rules V1.3 Fig. 5): heart-shaped
box ~16x7x18 cm, 300-gsm art card, one raw no.0 egg inside, ~90 g. Carried in
the X6100 belly via a gz DetachableJoint (sitl/models/eft_x6100/model.sdf)
and shed onto the pad on release. Unlike the static cargo_box (L&amp;R ground
dressing), this model has mass + inertia and loads the flight dynamics while
aboard.</description>
</model>
