<?xml version="1.0" ?>
<!-- Primitive tree: brown cylinder trunk + green sphere canopy (~4.5 m tall).
     Static scenery placed OUTSIDE the 60 m field so it never obstructs the
     flight corridor, targets, or landings. -->
<sdf version="1.9">
  <model name="tree">
    <static>true</static>
    <link name="link">
      <visual name="trunk">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.25</radius><length>2.0</length></cylinder>
        </geometry>
        <material>
          <ambient>0.34 0.22 0.11 1</ambient>
          <diffuse>0.40 0.26 0.13 1</diffuse>
        </material>
      </visual>
      <visual name="canopy">
        <pose>0 0 3.1 0 0 0</pose>
        <geometry>
          <sphere><radius>1.5</radius></sphere>
        </geometry>
        <material>
          <ambient>0.10 0.34 0.12 1</ambient>
          <diffuse>0.13 0.46 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="trunk_col">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.3</radius><length>2.0</length></cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
