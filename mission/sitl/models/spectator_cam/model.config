<?xml version="1.0"?>
<model>
  <name>spectator_cam</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>AAVC 2026 team</name>
    <email>pakin.c@eng.kmutnb.ac.th</email>
  </author>
  <description>
    Static third-person spectator camera that watches the launch pad / sys-ID
    hover column. Publishes the gz topic /spectator_camera; the camera bridge
    mirrors it to /tmp/aavc_spectator.png for the Tuning webapp's right rail.
    Not an onboard sensor — it never moves with the drone.
  </description>
</model>
