 # -----------------------------------------------------------------------
 
+# AAVC: keep an ambient PX4_GZ_MODELS (the launcher points it at the repo's own
+# model dir). Written long-hand because configure_file() expands shell-style
+# default syntax as a CMake variable and rejects the colon in it.
+if [ -z "$PX4_GZ_MODELS" ]; then
 export PX4_GZ_MODELS=@PX4_SOURCE_DIR@/Tools/simulation/gz/models
+fi
 export PX4_GZ_WORLDS=@PX4_SOURCE_DIR@/Tools/simulation/gz/worlds
 export PX4_GZ_PLUGINS=@PX4_BINARY_DIR@/src/modules/simulation/gz_plugins
