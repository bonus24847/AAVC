# ⚠ NOTHING IN THIS REPO LOADS A .env FILE (checked 2026-09-02: no python-dotenv
# call, no `set -a; . .env`, no Makefile include). These are plain environment
# variables — export them in your shell, or put them on the command line:
#
#     AAVC_PROFILE=competition make run
#
# This file is kept as the documentation of which variables exist.
#
# The lightweight AAVC build is fully offline + deterministic — no LLM, no
# cloud, no API keys. These are the only knobs the flight core reads.

# Mission profile — three exist (mission_brain/profile.py):
#   kmutnb_skyfield  practice, 10 m ceiling  <- the Makefile's own default
#   competition      KMITL, 30 m ceiling since the 2026-08-28 briefing
#   production       one egg per flight
# ⚠ Setting this to `competition` on the practice field flies the competition
# envelope over the rooftop pitch. The Makefile exports kmutnb_skyfield unless
# you override it; match that here so a copied file changes nothing by surprise.
AAVC_PROFILE=kmutnb_skyfield

# MAVLink endpoint the orchestrator connects to (PX4 SITL default).
# Bare udpin://:port (no IP) is rejected — keep the 0.0.0.0.
AAVC_MAVLINK=udpin://0.0.0.0:14540

# Live web dashboard (FastAPI) bind address.
AAVC_DASHBOARD_HOST=127.0.0.1
AAVC_DASHBOARD_PORT=8765
